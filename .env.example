# .env.example
# Claude API key from https://platform.claude.com (Claude Console)
ANTHROPIC_API_KEY=your_claude_api_key

# Optional: override the Claude models used
# CLAUDE_FAST_MODEL=claude-haiku-5-5
# CLAUDE_ANALYSIS_MODEL=claude-sonnet-5-5

# SMTP Configuration for the periodic report email (Zoho Mail)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=eswar@simuhire.online
SMTP_PASS=your_zoho_app_password

# Address the report email is sent from, and the address it is sent to
MAIL_FROM=eswar@simuhire.online
REPORT_RECIPIENT=eswar@simuhire.online
